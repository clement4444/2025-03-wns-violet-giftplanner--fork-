# prodution staging du fork
staging.gifchat-fork.032025-bleu-2.wns.wilders.dev {
        reverse_proxy localhost:3001
        log {
            output file /home/wns_student/apps/gifChat-fork/prodution_staging/log/caddy/caddy_access.log {
                roll_size 10mb
                roll_keep 5
                roll_keep_for 720h
            }
            format console
        }
}
